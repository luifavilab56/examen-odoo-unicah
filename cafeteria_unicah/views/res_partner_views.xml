<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_cafeteria_unicah" model="ir.ui.view">
        <field name="name">res.partner.form.cafeteria.unicah</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="cafeteria_unicah" string="Cafetería">
                    <group>
                        <field name="categoria_cliente"/>
                        <field name="codigo_carnet"
                               invisible="categoria_cliente not in ('becado', 'estudiante')"/>
                        <field name="facultad"
                               invisible="categoria_cliente not in ('becado', 'estudiante')"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>