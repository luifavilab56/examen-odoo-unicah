<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_cafeteria_unicah" model="ir.ui.view">
        <field name="name">sale.order.form.cafeteria.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_aplicar_beneficio"
                        string="Aplicar beneficio"
                        type="object"
                        invisible="not beneficio_id or beneficio_aplicado or state not in ('draft', 'sent')"/>
            </xpath>

            <field name="partner_id" position="after">
                <field name="categoria_cliente" readonly="1"/>
                <field name="beneficio_aplicado" invisible="1"/>
                <field name="beneficio_id"
                       readonly="beneficio_aplicado or state not in ('draft', 'sent')"
                       options="{'no_create': True}"/>
                <field name="total_sin_beneficio" invisible="not beneficio_aplicado"/>
            </field>
        </field>
    </record>

    <record id="view_sale_order_list_cafeteria_unicah" model="ir.ui.view">
        <field name="name">sale.order.list.cafeteria.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="beneficio_id" optional="show"/>
                <field name="total_sin_beneficio"
                       optional="show"
                       sum="Suma sin beneficio"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_search_cafeteria_unicah" model="ir.ui.view">
        <field name="name">sale.order.search.cafeteria.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="cafeteria_beneficio_pendiente"
                        string="Beneficio pendiente"
                        domain="[('beneficio_id', '!=', False), ('beneficio_aplicado', '=', False), ('state', 'in', ['draft', 'sent'])]"/>
                <separator/>
                <filter name="cafeteria_agrupar_beneficio"
                        string="Beneficio"
                        context="{'group_by': 'beneficio_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>